# Copie este arquivo para .env e preencha os valores.
# O .env esta no .gitignore e NAO deve ser enviado ao GitHub.

# ---------------------------------------------------------------
# WAHA
# ---------------------------------------------------------------
WAHA_API_KEY=troque-por-uma-chave-longa
WAHA_LOG_LEVEL=debug
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-esta-senha
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------
# n8n
# ---------------------------------------------------------------
# URL publica do n8n (IP da instancia ou dominio)
N8N_URL=http://SEU_IP:5678
# Usuario dono criado no primeiro acesso
N8N_OWNER_EMAIL=seu-email@exemplo.com
N8N_OWNER_PASSWORD=troque-esta-senha
# Chave que criptografa as credenciais salvas no n8n.
# Fica em ~/.n8n/config (campo encryptionKey). Sem ela, as credenciais importadas nao abrem.
N8N_ENCRYPTION_KEY=
# API key do n8n local (usada pelo MCP n8n-mesa-certa em 127.0.0.1:5678)
N8N_LOCAL_API_KEY=

# ---------------------------------------------------------------
# MCP (servidor MCP de instancia do n8n)
# ---------------------------------------------------------------
N8N_MCP_URL=http://SEU_IP:5678/mcp-server/http
# Token gerado em Settings > Instance-level MCP > Connect > API key
N8N_MCP_TOKEN=

# ---------------------------------------------------------------
# AWS / EC2
# ---------------------------------------------------------------
AWS_REGION=us-east-1
EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
EC2_PUBLIC_IP=0.0.0.0
EC2_ALLOCATION_ID=eipalloc-xxxxxxxxxxxxxxxxx
EC2_SECURITY_GROUP=sg-xxxxxxxxxxxxxxxxx
EC2_KEY_NAME=waha-n8n-key
EC2_KEY_FILE=C:\caminho\para\waha-n8n-key.pem
EC2_SSH_USER=ec2-user

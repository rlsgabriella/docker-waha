    {
      "parameters": {
        "jsCode": "const WAHA_URL = 'http://SEU_WAHA_HOST:3000';\nconst NUMEROS_AUTORIZADOS = []; // ex.: ['5511999999999']. Vazio = libera todos.\nconst MAX_TEXTO = 1000;\n\nconst item = $input.first().json;\nconst body = item.body ?? item;\nif (body.event && body.event !== 'message') return [];\n\nconst p = body.payload ?? {};\nif (p.fromMe === true) return [];\n\nconst chatId = p.from ?? '';\nif (!chatId || chatId.endsWith('@g.us') || chatId.endsWith('@broadcast') || chatId.endsWith('@newsletter')) return [];\n\nconst telefone = chatId.replace(/@.*/, '');\nif (NUMEROS_AUTORIZADOS.length && !NUMEROS_AUTORIZADOS.includes(telefone)) return [];\n\nconst messageId = p.id ?? '';\nconst sd = $getWorkflowStaticData('global');\nconst vistos = sd.vistos ?? [];\nif (messageId && vistos.includes(messageId)) return [];\nif (messageId) { vistos.push(messageId); sd.vistos = vistos.slice(-200); }\n\nconst mime = p.media?.mimetype ?? '';\nconst texto = String(p.body ?? '').trim().slice(0, MAX_TEXTO);\nlet tipo = 'outros';\nif (!p.hasMedia) { if (texto) tipo = 'texto'; }\nelse if (mime.startsWith('image/')) tipo = 'imagem';\nelse if (mime.startsWith('audio/')) tipo = 'audio';\n\nlet mediaUrl = p.media?.url ?? '';\nif (mediaUrl) { try { const u = new URL(mediaUrl); mediaUrl = WAHA_URL + u.pathname + u.search; } catch (e) {} }\n\nreturn [{ json: { chatId, telefone, session: body.session ?? 'default', messageId, tipo, texto, mimeType: mime, mediaUrl, wahaUrl: WAHA_URL } }];"
      },

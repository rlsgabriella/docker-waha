      "id": "d4000000-0000-4000-8000-000000000001",
      "name": "Memória da Conversa"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = $input.item.json.output ?? '';\nconst base = $('Filtra e Normaliza').first().json;\nconst CATS = ['Alimentação','Transporte','Saúde','Moradia','Lazer','Educação','Compras','Serviços','Salário','Investimentos','Outros'];\nconst LIMITE = 100000;\n\nlet d = null;\ntry { const m = String(out).match(/\\{[\\s\\S]*\\}/); d = JSON.parse(m ? m[0] : out); } catch (e) {}\n\nconst fail = (r) => ({ json: { valido: false, chatId: base.chatId, resposta: r } });\nif (!d) return fail('Não entendi. Pode repetir informando o valor e o que foi?');\nif (d.eh_transacao !== true) return fail(d.resposta || 'Me diga um gasto ou ganho, por exemplo: \"gastei 35 no almoço\".');\n\nconst tipo = String(d.tipo || '').toUpperCase();\nconst valor = Number(d.valor);\nconst descricao = String(d.descricao || '').trim().slice(0, 200);\n\nif (!['RECEITA', 'DESPESA'].includes(tipo)) return fail('Isso foi uma receita ou uma despesa?');\nif (!Number.isFinite(valor) || valor <= 0) return fail('Não identifiquei o valor. Quanto foi?');\nif (valor > LIMITE) return fail('O valor passou do limite de R$ 100.000 por registro. Confirme o valor, por favor.');\nif (descricao.length < 3) return fail('Pode dizer com o que foi esse lançamento?');\nif (d.confianca === 'baixa') return fail(d.resposta || 'Não tenho certeza dos dados. Pode confirmar o valor e a descrição?');\n\nconst categoria = CATS.includes(d.categoria) ? d.categoria : 'Outros';\nconst v = valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\nreturn { json: { valido: true, chatId: base.chatId, registro: { user_phone: base.telefone, tipo, valor: Math.round(valor * 100) / 100, categoria, descricao }, resposta: `✅ ${tipo === 'DESPESA' ? 'Despesa' : 'Receita'} registrada: ${v} em ${categoria} (${descricao}).` } };"
      },
